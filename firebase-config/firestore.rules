rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuth() {
      return request.auth != null;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      
      allow create: if isAuth() 
        && request.resource.data.contenido.size() < 300 
        && request.resource.data.usuarioId == request.auth.uid 
        && request.resource.data.likesCount is int 
        && request.resource.data.likesCount >= 0;
        
      allow update: if isAuth() 
        && (
          (request.resource.data.usuarioId == request.auth.uid)
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
           && request.resource.data.likesCount is int
           && request.resource.data.likesCount >= 0)
        );

      allow delete: if isAuth() && resource.data.usuarioId == request.auth.uid;
        
      match /likes/{userId} {
        allow read: if true;
        allow write: if isAuth() && userId == request.auth.uid;
      }
    }

    match /usuarios/{userId} {
      allow read: if true;
      
      allow create: if isAuth() && userId == request.auth.uid;
      
      allow update: if isAuth() 
        && (
          (userId == request.auth.uid)
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['countFollowers'])
           && request.resource.data.countFollowers is int
           && request.resource.data.countFollowers >= 0)
        );

      allow delete: if isAuth() && userId == request.auth.uid;
        
      match /followers/{followerId} {
        allow read: if true;
        allow write: if isAuth() && followerId == request.auth.uid;
      }
    }
  }
}
